# Environment Configuration for Smart DNS Server

# Внешний публичный IPv4-адрес вашего сервера
SERVER_IP=179.254.143.17

# Домен DuckDNS для выпуска SSL и защищенного DNS (DoT / DoQ / Web)
DUCKDNS_DOMAIN=videohub25.duckdns.org

# Токен вашей учетной записи DuckDNS (UUID со страницы duckdns.org)
DUCKDNS_TOKEN=your-duckdns-token-uuid

# Постоянная ссылка на сырой файл domains.txt в GitHub Gist (без хэша коммита)
GIST_URL=https://gist.githubusercontent.com/fd25-cyber/06084693e9c14ed6accc0c8e165c2fbf/raw/domains.txt

# Порт веб-интерфейса AdGuard Home
AG_WEB_PORT=3000
